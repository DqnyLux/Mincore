<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.dqnylux</groupId>
    <artifactId>CoreEC</artifactId>
    <version>1.0</version>
    <description>algoxd</description>
    <packaging>jar</packaging>

    <properties>
        <!-- 21: lo que exige Paper 1.21.x de verdad (desde 1.20.5). El proyecto
             corrió por un tiempo contra Minecraft 26.1 (que sí exigía Java 25),
             pero el server real bajó a la línea 1.21.x - Java 21 es el mínimo
             correcto para esa versión, no hace falta más. -->
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <defaultGoal>clean package</defaultGoal>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <!-- <release> en vez de <source>/<target> por separado: le dice a
                         javac que compile contra el conjunto de APIs REAL de Java 21
                         (no solo la sintaxis del lenguaje) - así si el código usa sin
                         querer algo agregado en Java 22+ (aunque el JDK que compila
                         sea más nuevo), falla acá mismo en vez de reventar en el
                         server real, que puede correr solo con JDK 21. Además evita
                         el warning "location of system modules is not set". -->
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-parameters</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <!-- MAVEN-SHADE-PLUGIN eliminado para TODO excepto EntityLib (ver
                 abajo): el resto de dependencias sigue sin incrustarse, todo
                 se descarga vía MincoreLoader como siempre. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.0</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <!-- SOLO EntityLib (io.github.tofaa2) se incrusta -
                                 excepción puntual, no un cambio de política general.
                                 Motivo: EntityLib necesita interoperar en tiempo de
                                 tipo con la MISMA instancia de PacketEventsAPI que ya
                                 usa el resto de Mincore (viene del plugin "packetevents"
                                 real vía delegación entre classloaders de plugins). El
                                 classloader de librería aislado que arma MincoreLoader
                                 para el resto de dependencias NO tiene esa delegación
                                 (aislamiento intencional de Paper para que un plugin
                                 pueda bundlear su propia versión de una librería sin
                                 chocar con otros plugins) - probado en vivo: con
                                 EntityLib como librería aparte, o termina con su propia
                                 copia sin inicializar de PacketEventsAPI (NPE) o no
                                 puede resolverla en absoluto (NoClassDefFoundError),
                                 sin punto intermedio. Incrustado en el jar de Mincore,
                                 sus clases cargan con EL MISMO classloader que ya tiene
                                 esa delegación funcionando (GlowManager, FreezeManager,
                                 etc. la usan hace rato sin problema).
                                 packetevents-spigot NO se incluye acá - EntityLib solo
                                 necesita ver sus clases (com.github.retrooper.packetevents.*
                                 Y io.github.retrooper.packetevents.bstats.*), ambas ya
                                 expuestas por el plugin "packetevents" real una vez que
                                 EntityLib comparte el classloader de Mincore. -->
                            <artifactSet>
                                <includes>
                                    <include>io.github.tofaa2:*</include>
                                    <!-- Drivers JDBC de MariaDB/MySQL - ver el comentario largo
                                         en la <dependency> de más abajo sobre por qué van
                                         incrustados en vez de resueltos por MincoreLoader. -->
                                    <include>org.mariadb.jdbc:*</include>
                                    <include>com.mysql:*</include>
                                </includes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>me.tofaa.entitylib</pattern>
                                    <shadedPattern>org.dqnylux.mincore.libs.entitylib</shadedPattern>
                                </relocation>
                            </relocations>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>module-info.class</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <!-- mariadb-java-client y mysql-connector-j registran cada
                                 uno su propio META-INF/services/java.sql.Driver - sin
                                 esto, shade se queda con UNO solo de los dos (el otro
                                 se pisa en silencio). No lo necesitamos en la práctica
                                 (DatabaseManager ya fija el driver por nombre de clase
                                 explícito, sin depender de ServiceLoader), pero fusionar
                                 en vez de sobrescribir es el fix correcto y elimina la
                                 ambigüedad de raíz para cualquier META-INF/services/*
                                 futuro. -->
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
    </build>

    <repositories>
        <repository><id>papermc-repo</id><url>https://repo.papermc.io/repository/maven-public/</url></repository>
        <repository><id>okaeri-releases</id><url>https://repo.okaeri.cloud/releases</url></repository>
        <repository><id>xenondevs</id><url>https://repo.xenondevs.xyz/releases</url></repository>
        <repository><id>codemc-releases</id><url>https://repo.codemc.io/repository/maven-releases/</url></repository>
        <repository>
            <!-- Solo para TAB-API (release, no SNAPSHOT). Snapshots
                 deshabilitados a propósito: jitpack exige token desde 2025
                 (401), y sin esto Maven lo probaba igual para CADA
                 dependencia -SNAPSHOT del proyecto (floodgate/geyser/
                 entitylib, que en realidad viven en otros repos) generando
                 warnings 401 ruidosos en cada build por nada. -->
            <id>jitpack.io</id>
            <url>https://jitpack.io</url>
            <snapshots><enabled>false</enabled></snapshots>
        </repository>
        <repository><id>placeholderapi</id><url>https://repo.helpch.at/releases/</url></repository>
        <repository>
            <id>opencollab-snapshots</id>
            <url>https://repo.opencollab.dev/maven-snapshots/</url>
            <releases><enabled>false</enabled></releases>
            <snapshots><enabled>true</enabled></snapshots>
        </repository>
        <repository>
            <id>opencollab-releases</id>
            <url>https://repo.opencollab.dev/maven-releases/</url>
        </repository>
        <repository>
            <!-- EntityLib (Tofaa) - librería sobre PacketEvents para entidades
                 falsas (TextDisplay del nametag propio, ver managers/nametag).
                 Publican solo versiones "-SNAPSHOT" como esquema permanente,
                 no como builds inestables en movimiento - repo Reposilite real
                 con metadata de snapshot válida, no jitpack. -->
            <id>pvphub-tofaa</id>
            <url>https://maven.pvphub.me/tofaa</url>
        </repository>
    </repositories>

    <!-- TODAS LAS DEPENDENCIAS EN PROVIDED (Solo sirven para que el IDE no marque errores) -->
    <dependencies>
        <dependency>
            <!-- 1.21.11 (última build 1.21.x del repo de PaperMC): producción
                 bajó de la línea 26.1 a 1.21.x - el plugin ahora compila y
                 corre contra esta API. TaskScheduler (org.dqnylux.mincore.scheduler)
                 abstrae el scheduler de Folia para que el mismo jar funcione
                 igual en Paper normal (sin Folia) y en Folia. -->
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.11-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>eu.okaeri</groupId>
            <artifactId>okaeri-configs-yaml-snakeyaml</artifactId>
            <version>6.1.0-beta.4</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
            <version>7.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
            <version>7.1.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.cryptomorin</groupId>
            <artifactId>XSeries</artifactId>
            <version>13.7.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.retrooper</groupId>
            <artifactId>packetevents-spigot</artifactId>
            <version>2.13.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- triumph-gui reemplaza a InvUI (ver historial de commits: InvUI dio 4
                 fallos distintos encadenados en producción, todos por depender de
                 acceso a NMS/internals - reflexión por versión en v1, acceso directo
                 sin ofuscar en v2, y en ambos casos rompía en cuanto la build real del
                 servidor (UniverseSpigot) divergía un poco de lo que la librería
                 esperaba). triumph-gui-paper es 100% API pública de Bukkit/Paper
                 (Inventory, ItemStack, PersistentDataContainer) - el único camino con
                 reflexión de NMS (LegacyNbt) es un fallback para servidores <1.14 que
                 nunca se activa aquí. Por eso funciona igual sin importar el fork
                 (Spigot/Paper/Purpur/Pufferfish/UniverseSpigot) o la versión exacta del
                 servidor - justo lo que se necesitaba. -->
            <groupId>dev.triumphteam</groupId>
            <artifactId>triumph-gui-paper</artifactId>
            <version>3.1.13</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.kyori</groupId>
            <artifactId>adventure-platform-bukkit</artifactId>
            <version>4.4.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.revxrsal</groupId>
            <artifactId>lamp.common</artifactId>
            <version>4.0.0-rc.17</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.github.revxrsal</groupId>
            <artifactId>lamp.bukkit</artifactId>
            <version>4.0.0-rc.17</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>me.clip</groupId>
            <artifactId>placeholderapi</artifactId>
            <version>2.12.3</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.53.2.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- FALTABAN: DatabaseConfig.MySQL.type soporta "MySQL"/"MariaDB" y
                 DatabaseManager arma jdbc:mariadb://.../jdbc:mysql://... para ambos,
                 pero nunca hubo un driver JDBC real en el classpath - solo
                 sqlite-jdbc estaba. Con mysql.enabled=true esto rompía SIEMPRE con
                 "Failed to get driver instance", cayendo a datos en blanco en cada
                 join (PlayerManager.loadPlayer: dataSource null -> PlayerData por
                 defecto, sin cosméticos ni coins).

                 A diferencia de sqlite-jdbc/HikariCP/etc (que sí quedan en
                 "provided" y se resuelven en runtime vía MincoreLoader como
                 siempre), ESTOS DOS van con scope normal (compile) e INCRUSTADOS
                 en el jar vía maven-shade-plugin (ver abajo, mismo mecanismo que
                 EntityLib) - un host de hosting compartido puede tener salida a
                 internet restringida y el MavenLibraryResolver de Paper fallar en
                 silencio para un artefacto puntual sin loguear nada claro (visto
                 en vivo: mismo error "Failed to get driver instance" después de
                 agregarlo a MincoreLoader). Incrustado en el jar no depende de que
                 el server pueda alcanzar Maven Central al arrancar. -->
            <groupId>org.mariadb.jdbc</groupId>
            <artifactId>mariadb-java-client</artifactId>
            <version>3.5.3</version>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <version>9.3.0</version>
        </dependency>
        <dependency>
            <!-- Igual que LuckPerms/PAPI/PacketEvents: Geyser y Floodgate son plugins
                 completos que el propio servidor instala por separado - solo necesitamos
                 el stub de compilación, nunca se añaden al MincoreLoader (sección 20). -->
            <groupId>org.geysermc.floodgate</groupId>
            <artifactId>api</artifactId>
            <version>2.2.5-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.geysermc.geyser</groupId>
            <artifactId>api</artifactId>
            <version>2.11.0-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>net.luckperms</groupId>
            <artifactId>api</artifactId>
            <version>5.5</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.github.MilkBowl</groupId>
            <artifactId>VaultAPI</artifactId>
            <version>1.7.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Bot de Discord (no un webhook - un webhook es de una sola vía,
                 no puede recibir clics de botón de vuelta) para aprobar/
                 rechazar en caliente los patrones que la IA de moderación
                 aprende de mensajes tóxicos confirmados (ver
                 ChatFilterManager.PendingPattern / DiscordApprovalBot).
                 Mismo patrón "provided" que HikariCP/jedis/etc - se resuelve
                 en runtime vía MincoreLoader, nunca se incrusta en el jar. -->
            <groupId>net.dv8tion</groupId>
            <artifactId>JDA</artifactId>
            <version>5.6.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Igual que LuckPerms/Floodgate/PAPI: TAB Reborn es un plugin
                 completo que el propio servidor instala por separado - solo
                 el stub de compilación, nunca en MincoreLoader (ver su
                 javadoc: jitpack exige token en runtime). El acceso real pasa
                 SIEMPRE por TabHook.isInstalled() antes de tocar cualquier
                 clase de este paquete, mismo patrón que BedrockUtil para
                 Floodgate - nunca debe crashear un server sin TAB instalado. -->
            <groupId>com.github.NEZNAMY</groupId>
            <artifactId>TAB-API</artifactId>
            <version>6.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- Mismo patrón que TAB-API justo arriba: LiteBans es un plugin
                 completo que el propio servidor instala por separado - esto
                 es solo el stub de compilación (litebans.api.Database),
                 nunca va en MincoreLoader (jitpack exige token en runtime).
                 El acceso real pasa SIEMPRE por LiteBansHook.isInstalled()
                 antes de tocar litebans.api.* (ver LiteBansHook/
                 LiteBansMuteBridge, usado por ChatListener para chequear
                 mute de forma proactiva en vez de confiar en el orden de
                 cancelación entre el AsyncChatEvent de Paper y el
                 AsyncPlayerChatEvent legacy que LiteBans pueda escuchar). -->
            <groupId>com.gitlab.ruany</groupId>
            <artifactId>LiteBansAPI</artifactId>
            <version>0.4.1</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <!-- A diferencia de TAB/LuckPerms/Floodgate/etc (provided, se
                 resuelven en runtime vía MincoreLoader o vienen de otro
                 plugin), EntityLib se INCRUSTA en el jar (maven-shade-plugin
                 arriba, relocado a org.dqnylux.mincore.libs.entitylib) - por
                 eso scope normal (compile), no provided: shade solo empaqueta
                 dependencias compile/runtime. Ver el comentario del plugin de
                 shade para el porqué (interoperar en tiempo de tipo con la
                 misma instancia de PacketEventsAPI que ya usa el resto de
                 Mincore, algo que un classloader de librería aislado no
                 puede hacer). -->
            <groupId>io.github.tofaa2</groupId>
            <artifactId>common</artifactId>
            <version>3.3.6-SNAPSHOT</version>
        </dependency>
        <dependency>
            <groupId>io.github.tofaa2</groupId>
            <artifactId>spigot</artifactId>
            <version>3.3.6-SNAPSHOT</version>
        </dependency>
    </dependencies>
</project>